# Copiar este archivo a ".env" y ajustar los valores.
# Ninguno de estos valores se envia al cliente; solo configuran el
# proceso Node.js y la conexion directa a PostgreSQL.

# --- Servidor ---
PORT=3000
NODE_ENV=production
SESSION_SECRET=cambia-este-valor-por-una-cadena-larga-y-aleatoria

# --- PostgreSQL ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user
PGPASSWORD=library666

# --- Subida de imagenes ---
# Tamano maximo por imagen en bytes (5 MB por defecto)
UPLOAD_MAX_BYTES=5242880
